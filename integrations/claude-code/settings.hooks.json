{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "laya-guard hook --agent claude-code", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "laya-guard hook --agent claude-code", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Read|mcp__.*",
        "hooks": [
          { "type": "command", "command": "laya-guard hook --agent claude-code", "timeout": 10 }
        ]
      }
    ]
  }
}
